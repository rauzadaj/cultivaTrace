APP_ENV=prod
APP_SECRET=CHANGE_ME_32_char_random_string
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?serverVersion=16&charset=utf8
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?serverVersion=16&charset=utf8

JWT_SECRET_KEY=%kernel.project_dir%/var/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/var/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME_strong_passphrase

MAILER_DSN=smtp://USER:PASSWORD@HOST:PORT
FRONTEND_URL=https://YOUR_DOMAIN
GOTENBERG_URL=http://gotenberg:3000

MERCURE_URL=http://localhost:9000/.well-known/mercure
MERCURE_PUBLIC_URL=https://YOUR_DOMAIN/.well-known/mercure
MERCURE_JWT_SECRET=CHANGE_ME_strong_secret

# Frontend Vite env — must match FRONTEND_URL so Mercure topic URIs align
VITE_FRONTEND_URL=https://YOUR_DOMAIN

STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_GROWTH=price_CHANGE_ME_GROWTH
STRIPE_PRICE_PRO=price_CHANGE_ME_PRO
STRIPE_PRICE_SCALE=price_CHANGE_ME_SCALE
STRIPE_PRICE_ENTERPRISE=price_CHANGE_ME_ENTERPRISE
STRIPE_ALERT_FROM_EMAIL=billing@YOUR_DOMAIN

AUDIT_CHAIN_SECRET=CHANGE_ME_64_char_random_hex_string_for_hmac_audit_trail

LICENSE_ALERT_FROM_EMAIL=licenses@YOUR_DOMAIN

KYB_METRC_API_KEY=CHANGE_ME_if_using_METRC
KYB_ALERT_FROM_EMAIL=kyb@YOUR_DOMAIN
KYB_ADMIN_REVIEW_EMAIL=compliance@YOUR_DOMAIN
KYB_ADMIN_REVIEW_URL=https://YOUR_DOMAIN/admin/kyb
KYB_SUPPORT_EMAIL=support@YOUR_DOMAIN
KYB_ENABLE_DEV_SIMULATION=0

SENTRY_DSN=
KYB_STORAGE_ROOT=/var/www/html/var/storage/licenses
REPORT_EXPORT_STORAGE_ROOT=/var/www/html/var/storage/report_exports

# Playwright E2E test credentials (never use real production credentials here)
E2E_DEMO_EMAIL=demo@cultivatrace.local
E2E_DEMO_PASSWORD=CHANGE_ME_e2e_password
