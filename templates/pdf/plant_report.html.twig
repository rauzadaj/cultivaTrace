<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Rapport Plant — CultivaTrace</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 11px; color: #1A202C; line-height: 1.5; }

    .header { background: #1B6B3A; color: white; padding: 16px 24px; display: flex; justify-content: space-between; align-items: flex-start; }
    .header h1 { font-size: 18px; font-weight: 700; }
    .header .meta { font-size: 10px; opacity: 0.85; text-align: right; }

    .section { padding: 14px 24px; border-bottom: 1px solid #E2E8F0; }
    .section-title { font-size: 12px; font-weight: 700; color: #1B6B3A; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px; }

    .info-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .info-item label { font-size: 9px; color: #718096; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 2px; }
    .info-item span { font-size: 12px; font-weight: 600; }

    .stage-badge { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: 10px; font-weight: 700; }
    .stage-germination { background: #E8F5E9; color: #2E7D32; }
    .stage-vegetation  { background: #E8F5E9; color: #1B6B3A; }
    .stage-flowering   { background: #FFF3E0; color: #E65100; }
    .stage-harvest     { background: #FFEBEE; color: #C62828; }
    .stage-archived    { background: #F5F5F5; color: #616161; }

    table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 10px; }
    th { background: #1B6B3A; color: white; padding: 5px 8px; text-align: left; font-size: 9px; font-weight: 700; }
    td { padding: 4px 8px; border-bottom: 1px solid #E2E8F0; }
    tr:nth-child(even) td { background: #F7F8FA; }

    .timeline-event { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px solid #F0F0F0; }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: #1B6B3A; margin-top: 5px; flex-shrink: 0; }
    .event-type { font-weight: 700; font-size: 10px; color: #1B6B3A; }
    .event-meta { font-size: 9px; color: #718096; }
    .event-notes { font-size: 10px; color: #4A5568; margin-top: 2px; }

    .integrity-ok  { background: #E8F5E9; border: 1px solid #2E7D32; border-radius: 4px; padding: 8px; color: #1B6B3A; }
    .integrity-nok { background: #FFEBEE; border: 1px solid #C62828; border-radius: 4px; padding: 8px; color: #C62828; }

    .hash-value { font-family: 'Courier New', monospace; font-size: 8px; word-break: break-all; color: #4A5568; margin-top: 4px; }

    .footer { padding: 10px 24px; background: #F7F8FA; display: flex; justify-content: space-between; font-size: 9px; color: #718096; border-top: 1px solid #E2E8F0; }

    @media print { body { print-color-adjust: exact; -webkit-print-color-adjust: exact; } }
  </style>
</head>
<body>

<div class="header">
  <div>
    <h1>CultivaTrace — Rapport de Traçabilité</h1>
    <div style="font-size:10px; margin-top:3px; opacity:0.9;">Rapport Seed-to-Harvest certifié • Audit Trail SHA-256</div>
  </div>
  <div class="meta">
    Généré le {{ generatedAt|date('d/m/Y à H:i') }}<br>
    Ref. : {{ plant.id|slice(0,8)|upper }}<br>
    {{ totalEvents }} événements tracés
  </div>
</div>

<div class="section">
  <div class="section-title">Informations du Plant</div>
  <div class="info-grid">
    <div class="info-item"><label>Identifiant</label><span>{{ plant.id }}</span></div>
    <div class="info-item"><label>Génétique</label><span>{{ plant.strain ? plant.strain.name ~ ' (' ~ plant.strain.genetics ~ ')' : 'Non définie' }}</span></div>
    <div class="info-item"><label>Type cannabis</label><span>{{ plant.strain ? plant.strain.cannabisType|upper : 'N/A' }}</span></div>
    <div class="info-item"><label>Stade actuel</label><span><span class="stage-badge stage-{{ plant.stage.value }}">{{ plant.stage.value|capitalize }}</span></span></div>
    <div class="info-item"><label>Statut</label><span>{{ plant.status.value|capitalize }}</span></div>
    <div class="info-item"><label>Salle</label><span>{{ plant.room.name }}</span></div>
    <div class="info-item"><label>Germination</label><span>{{ plant.germinatedAt|date('d/m/Y') }}</span></div>
    <div class="info-item"><label>Âge</label><span>{{ plant.ageInDays }} jours</span></div>
    <div class="info-item"><label>Tag RFID</label><span>{{ plant.rfidTag ?? '—' }}</span></div>
  </div>
</div>

{% if harvestRecord %}
<div class="section">
  <div class="section-title">Données de Récolte</div>
  <div class="info-grid">
    <div class="info-item"><label>Date</label><span>{{ harvestRecord.harvestedAt|date('d/m/Y') }}</span></div>
    <div class="info-item"><label>Poids brut</label><span>{{ harvestRecord.grossWeightG }} g</span></div>
    <div class="info-item"><label>Poids net</label><span>{{ harvestRecord.netWeightG }} g</span></div>
    <div class="info-item"><label>Ratio rendement</label><span>{{ harvestRecord.yieldRatio }} %</span></div>
    <div class="info-item"><label>Récolté par</label><span>{{ harvestRecord.harvestedBy.email }}</span></div>
  </div>
</div>
{% endif %}

{% if inputRecords|length > 0 %}
<div class="section">
  <div class="section-title">Intrants ({{ inputRecords|length }})</div>
  <table>
    <thead><tr>
      <th>Date</th><th>Type</th><th>Produit</th><th>Quantité</th><th>Unité</th>
      <th>LoQ (mg/kg)</th><th>Résultat</th><th>Appliqué par</th>
    </tr></thead>
    <tbody>
      {% for r in inputRecords %}
      <tr>
        <td>{{ r.appliedAt|date('d/m/Y') }}</td>
        <td>{{ r.inputType|capitalize }}</td>
        <td>{{ r.productName }}</td>
        <td>{{ r.quantity }}</td>
        <td>{{ r.unit }}</td>
        <td>{{ r.loqValue ?? '—' }}</td>
        <td style="font-weight:700; color: {% if r.testResult == 'fail' %}#C62828{% elseif r.testResult == 'pass' %}#2E7D32{% else %}#718096{% endif %}">
          {{ r.testResult ?? '—' }}
        </td>
        <td>{{ r.appliedBy.email }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

<div class="section">
  <div class="section-title">Audit Trail ({{ totalEvents }} événements)</div>
  {% for event in events %}
  <div class="timeline-event">
    <div class="dot"></div>
    <div style="flex:1">
      <div class="event-type">{{ event.eventType|replace({'_': ' '})|upper }}</div>
      <div class="event-meta">{{ event.occurredAt|date('d/m/Y H:i:s') }} — {{ event.user.email }} — Hash : {{ event.hashSelf|slice(0,16) }}…</div>
      {% if event.notes %}<div class="event-notes">{{ event.notes }}</div>{% endif %}
      {% if event.payload %}<div class="event-notes" style="font-family:monospace; font-size:9px; color:#718096;">{{ event.payload|json_encode }}</div>{% endif %}
    </div>
  </div>
  {% endfor %}
</div>

<div class="section">
  <div class="section-title">Vérification d'Intégrité</div>
  <div class="{{ integrity.valid ? 'integrity-ok' : 'integrity-nok' }}">
    {% if integrity.valid %}
      ✅ Chaîne de hash intacte — {{ integrity.checked }} événements vérifiés
    {% else %}
      ❌ Rupture détectée à l'événement {{ integrity.broken_at }} — Audit trail compromis
    {% endif %}
  </div>
  {% if events|length > 0 %}
  <div class="hash-value">Hash final : {{ events|last.hashSelf }}</div>
  {% endif %}
</div>

<div class="footer">
  <div>CultivaTrace — Rapport certifié — {{ generatedAt|date('d/m/Y') }}</div>
  <div>Plant ID : {{ plant.id }} — Confidentiel</div>
</div>

</body>
</html>
