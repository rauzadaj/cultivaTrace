<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Audit Export</title>
  <style>
    body { font-family: Arial, sans-serif; color: #1f2937; font-size: 12px; }
    h1 { margin: 0 0 8px; }
    .meta { margin-bottom: 20px; color: #4b5563; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border-bottom: 1px solid #e5e7eb; padding: 8px 6px; text-align: left; vertical-align: top; }
    th { background: #f3f4f6; }
  </style>
</head>
<body>
  <h1>Tenant Audit Export</h1>
  <div class="meta">
    <div>{{ organization.name }}</div>
    <div>Période : {{ filters.dateFrom }} → {{ filters.dateTo }}</div>
    <div>Événements : {{ summary.eventCount }}</div>
    <div>Généré le {{ generatedAt|date('d/m/Y H:i') }}</div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Type</th>
        <th>Plant</th>
        <th>Salle</th>
        <th>Utilisateur</th>
        <th>Date</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
        <tr>
          <td>{{ row.eventType }}</td>
          <td>{{ row.rfidTag ?: row.plantId|slice(0, 8) }}</td>
          <td>{{ row.roomName }}</td>
          <td>{{ row.userEmail }}</td>
          <td>{{ row.occurredAt|date('d/m/Y H:i') }}</td>
          <td>{{ row.notes ?: '' }}</td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6">Aucun événement sur cette période.</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
